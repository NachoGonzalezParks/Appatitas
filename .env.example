# APPATITAS — Plantilla de variables de entorno (S0-06)
# Copiar a `.env.local` (desarrollo) / `.env.staging` / `.env.production` y completar.
# NO commitear los archivos con valores reales. Solo se versiona este `.env.example`.
# Ver docs/sprint-0-plan.md §2.1 y CONTRIBUTING.md §5.

# --- Cliente (PWA) ---------------------------------------------------------
# Vite solo expone al cliente las variables con prefijo VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Clave pública VAPID para Web Push (se usa en el Service Worker · Día 2 / HU-009)
VITE_VAPID_PUBLIC_KEY=

# --- Feature flags (activar/desactivar funciones sin tocar código) ---------
# Login con Facebook: DIFERIDO (falta nombre de la app + dominio + revisión de Meta).
# Poner en 'true' cuando esté todo listo. Ver docs/plan-desbloqueo.md.
VITE_ENABLE_FACEBOOK=false

# --- Solo servidor (Edge Functions · NUNCA en el cliente) ------------------
# Estas NO llevan prefijo VITE_ y no deben exponerse en el bundle del navegador.
# Se configuran como secrets en Supabase Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
VAPID_PRIVATE_KEY=
